{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure heuristic",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/heuristic/src",
                "-B",
                "${workspaceFolder}/heuristic/build",
                "-G",
                "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build heuristic",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/heuristic/build",
                "--parallel"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": [
                "CMake: Configure heuristic"
            ]
        },
        {
            "label": "Run heuristic",
            "type": "shell",
            "command": "${workspaceFolder}/heuristic/build/heuristic",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Build heuristic"
            ],
            "detail": "运行编译后的可执行文件"
        },
        {
            "label": "Build & Run heuristic",
            "type": "shell",
            "command": "echo 'Running Build & Run'",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Configure heuristic",
                "CMake: Build heuristic",
                "Run heuristic"
            ],
            "group": "test",
            "detail": "完整的构建并运行流程"
        },
        {
            "label": "Clean Build heuristic",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/heuristic/build/*"
            ],
            "detail": "清理构建目录"
        },
        {
            "label": "CMake: Configure ExactSolver",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/exact_solver/src",
                "-B", "${workspaceFolder}/exact_solver/build",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Release",
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build ExactSolver",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/exact_solver/build",
                "--parallel"
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": ["CMake: Configure ExactSolver"]
        },
        {
            "label": "Run ExactSolver",
            "type": "shell",
            "command": "${workspaceFolder}/exact_solver/build/ExactSolver",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "hide": true,     
            "dependsOn": ["CMake: Build ExactSolver"],
            "detail": "运行编译后的可执行文件"
        },
        {
            "label": "Build & Run ExactSolver",
            "type": "shell",
            "command": "echo 'Running Build & Run'",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Configure ExactSolver",
                "CMake: Build ExactSolver",
                "Run ExactSolver"
            ],
            "group": "test",
            "detail": "完整的构建并运行流程"
        },
        {
            "label": "Clean Build ExactSolver",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf", "${workspaceFolder}/exact_solver/build/*"
            ],
            "detail": "清理构建目录"
        }
    ]
}