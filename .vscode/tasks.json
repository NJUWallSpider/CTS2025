{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure ExactSolver",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/exact_solver/src",
                "-B", "${workspaceFolder}/exact_solver/build",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Release",
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build ExactSolver",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/exact_solver/build",
                "--parallel"
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": ["CMake: Configure ExactSolver"]
        },
        {
            "label": "Run ExactSolver",
            "type": "shell",
            "command": "${workspaceFolder}/exact_solver/build/ExactSolver",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "hide": true,     
            "dependsOn": ["CMake: Build ExactSolver"],
            "detail": "运行编译后的可执行文件"
        },
        {
            "label": "Build & Run ExactSolver",
            "type": "shell",
            "command": "echo 'Running Build & Run'",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Configure ExactSolver",
                "CMake: Build ExactSolver",
                "Run ExactSolver"
            ],
            "group": "test",
            "detail": "完整的构建并运行流程"
        },
        {
            "label": "Clean Build ExactSolver",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf", "${workspaceFolder}/exact_solver/build/*"
            ],
            "detail": "清理构建目录"
        },
        {
            "label": "CMake: Configure ExactSolver -- Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/exact_solver/src",
                "-B", "${workspaceFolder}/exact_solver/build",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug",
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build ExactSolver -- Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/exact_solver/build",
                "--parallel"
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": ["CMake: Configure ExactSolver -- Debug"]
        },
        {
            "label": "CMake: Configure Heuristic",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/heuristic/src",
                "-B", "${workspaceFolder}/heuristic/build",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Release",
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build Heuristic",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/heuristic/build",
                "--parallel"
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": ["CMake: Configure Heuristic"]
        },
        {
            "label": "Run ExactSolver",
            "type": "shell",
            "command": "${workspaceFolder}/heuristic/build/Heuristic",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "hide": true,     
            "dependsOn": ["CMake: Build Heuristic"],
            "detail": "运行编译后的可执行文件"
        },
        {   
            "label": "Build & Run Heuristic",
            "type": "shell",
            "command": "echo 'Running Build & Run'",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Configure Heuristic",
                "CMake: Build Heuristic",
                "Run Heuristic"
            ],
            "group": "test",
            "detail": "完整的构建并运行流程"
        },
        {
            "label": "Clean Build Heuristic",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf", "${workspaceFolder}/heuristic/build/*"
            ],
            "detail": "清理构建目录"
        },
        {
            "label": "CMake: Configure Heuristic -- Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/heuristic/src",
                "-B", "${workspaceFolder}/heuristic/build",
                "-G", "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug",
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "为项目生成构建系统"
        },
        {
            "label": "CMake: Build Heuristic -- Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/heuristic/build",
                "--parallel"
            ],
            "hide": true,     
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译项目",
            "dependsOn": ["CMake: Configure Heuristic -- Debug"]
        }
    ]
}

